{
  "name": "sergeich5/helpers",
  "type": "library",
  "require": {
    "php": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "ext-mbstring": "*",
    "spatie/laravel-data": "^4.23"
  },
  "autoload": {
    "files": [
      "src/laravel-data.php",
      "src/mb.php",
      "src/number.php",
